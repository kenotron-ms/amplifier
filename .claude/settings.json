{
  "permissions": {
    "allow": [
      "Bash",
      "mcp__playwright",
      "mcp__deepwiki",
      "WebFetch",
      "TodoWrite"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [".data", ".vscode", ".claude", ".ai"]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["playwright", "deepwiki"],
  "extraKnownMarketplaces": {
    "amplifier": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "amp@amplifier": true,
    "git@amplifier": true,
    "dev-kit@amplifier": true
  }
}
